# ============================================================================
# ATS Platform — single source of truth for ALL configuration (PRODUCTION).
# Copy to .env and fill in. Nothing is hardcoded in code; every value is read
# from here (or the process environment) at runtime.
# Use .env.development.example for the dev stack (.env.dev).
# ============================================================================

# ---- Environment ----
ENVIRONMENT=production            # development | production
NODE_ENV=production
HOST=0.0.0.0
PORT=8000
UVICORN_WORKERS=2                 # 4 vCPU host: 2 API workers, leave cores for match-worker

# ---- Compute ----
TORCH_NUM_THREADS=1               # CPU-only; bound BLAS/torch so containers don't oversubscribe vCPUs

# ---- URLs / CORS ----
DOMAIN=your-domain.example                        # nginx server_name + TLS cert path
FRONTEND_URL=https://your-domain.example
FRONTEND_ORIGIN=https://your-domain.example       # comma-separated CORS allowlist
NEXT_PUBLIC_API_URL=https://your-domain.example   # frontend -> backend base (via nginx /api)

# ---- Security / Auth (generate: python -c "import secrets;print(secrets.token_urlsafe(48))") ----
SECRET_KEY=CHANGE_ME
JWT_SECRET_KEY=CHANGE_ME
ACCESS_TOKEN_EXPIRES_MIN=720
ADMIN_USERNAME=CHANGE_ME
ADMIN_PASSWORD=CHANGE_ME
LOCAL_AUTH=false
LOCAL_AUTH_USERNAME=             # dev-only login bypass; leave empty in production
LOCAL_AUTH_PASSWORD=             # dev-only login bypass; leave empty in production
LOGIN_MAX_FAILED_ATTEMPTS=5      # wrong passwords before temporary lockout
LOGIN_LOCKOUT_SECONDS=900        # lockout duration (15 min)
PRESENCE_TTL_SECONDS=120         # user shows "online" on the admin page if seen within this many seconds

# ---- PostgreSQL (primary relational store: auth_db + cv_database) ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=cv_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=cv_database
AUTH_DB_URL=postgresql+psycopg2://cv_user:CHANGE_ME@postgres:5432/auth_db
TRACKER_DB_URL=postgresql+psycopg2://cv_user:CHANGE_ME@postgres:5432/cv_database

# ---- Qdrant (vector store) ----
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_MAX_CONNECTIONS=400
QDRANT_TIMEOUT_SECONDS=30
# QDRANT_API_KEY: optional; set to require auth to Qdrant (backend + qdrant service read it)
QDRANT_API_KEY=

# ---- Redis (cache, rate-limit state, OTP, queue broker) ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=50          # connection-pool size per process
REDIS_SOCKET_TIMEOUT=5            # seconds
REDIS_RECONNECT_INTERVAL=30       # retry Redis this often after an outage
REDIS_MAXMEMORY=2gb               # redis-server maxmemory (compose); keep <= redis container mem limit
REDIS_MAXCLIENTS=800

# ---- Microsoft Graph API (OTP email + mailbox CV intake) ----
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_MAILBOX_EMAIL=
OTP_FROM_EMAIL=cv@your-domain.example
OTP_FROM_NAME=ATS System
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_DISABLE_EMAIL=false  # dev only
OTP_RESEND_COOLDOWN_SECONDS=60   # min seconds between OTP emails per user
OTP_MAX_SENDS_PER_WINDOW=5       # OTP emails allowed per rolling window
OTP_SEND_WINDOW_SECONDS=900      # rolling window for the above (15 min)

# Image CAPTCHA (alternative second factor; set a user's auth mode to "captcha" in Admin)
CAPTCHA_LENGTH=6                 # characters in the CAPTCHA code
CAPTCHA_TTL_SECONDS=300          # how long a CAPTCHA challenge stays valid
CAPTCHA_MAX_ATTEMPTS=5           # wrong answers before the challenge is invalidated
CAPTCHA_MAX_SENDS_PER_WINDOW=8   # refreshes allowed per rolling window (sliding window)
CAPTCHA_SEND_WINDOW_SECONDS=600  # rolling window for the above (10 min)
CAPTCHA_RESEND_COOLDOWN_SECONDS=2 # min seconds between refreshes
GRAPH_SEND_RETRIES=2             # retries for transient Graph sendMail failures
GRAPH_SEND_RETRY_DELAY=1.5       # base backoff delay (seconds)
# EMAIL_WEBHOOK_SECRET: secret for the email webhook; empty = webhook DISABLED (404)
EMAIL_WEBHOOK_SECRET=

# ---- OpenAI / LLM ----
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini-2025-04-14
OPENAI_MAX_RETRIES=3
OPENAI_RETRY_BASE_DELAY=1
OPENAI_SEED=42
LLM_CACHE_DIR=/data/llm_cache
LLM_TIMEOUT_SECONDS=60
LLM_BULK_TIMEOUT_SECONDS=300

# ---- Storage (local | s3) ----
STORAGE_BACKEND=local             # local (uploads_data volume) | s3 (AWS S3)
LOCAL_STORAGE_DIR=/data/uploads
CV_UPLOAD_DIR=/data/uploads/cv
S3_BUCKET=                        # required when STORAGE_BACKEND=s3
S3_REGION=
S3_PREFIX=                        # optional key prefix inside the bucket
MAX_FILE_SIZE_MB=10
MAX_TEXT_INPUT_CHARS=50000
# Raw-CV retention: db/cleanup_old_cvs.py purges original files + embeddings
# of CVs older than this many days (0 = keep forever). Structured/search data,
# notes, tracker, auth and email-dedup records are always kept.
CV_RETENTION_DAYS=0

# ---- Rate limiting ----
RATE_LIMIT_DEBUG=false
ENABLE_RATE_LIMIT_METRICS=true
MAX_GLOBAL_CONCURRENT=100
CIRCUIT_BREAKER_THRESHOLD=10
CIRCUIT_BREAKER_RECOVERY_TIME=120
CLEANUP_INTERVAL=300
MEMORY_CLEANUP_THRESHOLD=10000
REPUTATION_DECAY_RATE=0.05
REPUTATION_PENALTY_RATE=0.02
MIN_REPUTATION=0.5
TRUST_PROXY_HEADERS=true
ALLOWED_PROXY_IPS=172.16.0.0/12,10.0.0.0/8

# ---- Matching performance ----
# Matching now runs in the dedicated match-worker container via a Redis queue.
# There is no longer a small hard cap on CVs per job — the worker streams
# candidates in chunks. MATCH_MAX_CVS is only an absurd-request ceiling (0 = off).
MATCH_MAX_CVS=5000               # safety ceiling per matching job (0 disables it)
MATCHING_TIMEOUT_SECONDS=3600    # hard timeout for one matching job
MAX_CONCURRENT_MATCHES=2         # bounds the inline fallback only (queue path uses the cap below)
MATCH_THREAD_POOL_WORKERS=4      # per-job scoring threads (keep small on a 4 vCPU host)
MATCH_CHUNK_SIZE=50              # CVs processed per parallel chunk
MATCH_QDRANT_BATCH_SIZE=256      # CV payloads fetched per Qdrant round-trip
MATCH_DOC_CACHE_TTL_SECONDS=300  # in-process TTL cache for Qdrant docs/embeddings
MATCH_DOC_CACHE_MAX_ITEMS=8000
MATCH_RESULT_CACHE_ENABLED=true  # Redis cache for (cv, jd, weights) match results
MATCH_RESULT_CACHE_TTL_SECONDS=1800
LIST_CACHE_TTL_SECONDS=60        # CV/JD list endpoint cache TTL

# ---- Match job queue (Redis-backed; consumed by the match-worker container) ----
ENABLE_MATCH_QUEUE=true          # false = run matching inline in the API process (not recommended)
MATCH_QUEUE_MAX_CONCURRENT_JOBS=1  # match jobs running at once across ALL match-worker replicas
MATCH_QUEUE_POLL_TIMEOUT=5       # worker blocking-pop timeout (seconds)
MATCH_JOB_STALE_SECONDS=5400     # a 'processing' job older than this is re-queued on worker startup
MATCH_JOB_TTL_SECONDS=86400      # how long job status + results live in Redis

# ---- Embeddings ----
EMBEDDING_MODEL_NAME=all-mpnet-base-v2
EMBEDDING_DIM=768                 # all-mpnet-base-v2 vector size (change model => recreate collections)
EMBEDDING_BATCH_SIZE=64
EMBEDDING_CACHE_TTL_SECONDS=3600

# ---- Queues / workers ----
ENABLE_APPLICATION_QUEUE=true
ENABLE_PUBLIC_CV_QUEUE=true       # public applications -> Redis queue -> public-cv-worker container
MAX_CONCURRENT_APPLICATIONS=5
APPLICATION_TIMEOUT_SECONDS=300
MIN_QUEUE_WORKERS=8
MAX_QUEUE_WORKERS=16
QUEUE_SIZE_THRESHOLD=10000

# ---- System thresholds ----
MEMORY_THRESHOLD_MB=12288
CPU_THRESHOLD_PERCENT=85

# ---- Feature flags ----
ENABLE_CANDIDATE_TRACKER=true
ENABLE_EMAIL_SCHEDULER=false
SEND_EMAIL_REMINDER_FOLLOWUP=false
EMAIL_CHECK_INTERVAL_MINUTES=5
EMAIL_MAX_BATCH_SIZE=10
EMAIL_SCHEDULE_UTC=
FOLLOWUP_REMINDER_TZ=Asia/Dubai
