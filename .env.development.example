# ============================================================================
# ATS Platform — DEVELOPMENT configuration. Copy to .env.dev.
# Used by docker-compose.dev.yml (./scripts/start.sh dev).
# Service hostnames refer to the dev compose network (postgres-dev, qdrant-dev,
# redis-dev). Dev-only conveniences (LOCAL_AUTH, OTP_DISABLE_EMAIL) are enabled
# here and are hard-disabled by the backend when ENVIRONMENT=production.
# ============================================================================

# ---- Environment ----
ENVIRONMENT=development
NODE_ENV=development
HOST=0.0.0.0
PORT=8000
UVICORN_WORKERS=2

# ---- Compute ----
TORCH_NUM_THREADS=1

# ---- URLs / CORS ----
DOMAIN=localhost
FRONTEND_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000,http://localhost
NEXT_PUBLIC_API_URL=http://localhost

# ---- Security / Auth ----
SECRET_KEY=dev_secret_key_change_me
JWT_SECRET_KEY=dev_secret_key_change_me
ACCESS_TOKEN_EXPIRES_MIN=1440
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
LOCAL_AUTH=true                  # dev-only login bypass (ignored in production)
LOCAL_AUTH_USERNAME=dev
LOCAL_AUTH_PASSWORD=dev_password_123
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
LOGIN_MAX_FAILED_ATTEMPTS_PER_ACCOUNT=50   # failures from ALL addresses before the account itself locks
# (LOGIN_MAX_FAILED_ATTEMPTS counts per username AND client IP, so a stranger cannot lock a real user out)
PRESENCE_TTL_SECONDS=120         # user shows "online" on the admin page if seen within this many seconds

# ---- PostgreSQL (dev container: postgres-dev, host port 5434) ----
POSTGRES_HOST=postgres-dev
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cv_analyzer_dev
AUTH_DB_URL=postgresql+psycopg2://postgres:postgres@postgres-dev:5432/auth_db
TRACKER_DB_URL=postgresql+psycopg2://postgres:postgres@postgres-dev:5432/cv_analyzer_dev

# ---- Qdrant (dev container: qdrant-dev, host port 6335) ----
QDRANT_HOST=qdrant-dev
QDRANT_PORT=6333
QDRANT_MAX_CONNECTIONS=10
QDRANT_TIMEOUT_SECONDS=30
# QDRANT_API_KEY: optional; set to require auth to Qdrant (backend + qdrant service read it)
QDRANT_API_KEY=

# ---- Redis (dev container: redis-dev, host port 6380) ----
REDIS_HOST=redis-dev
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=20
REDIS_SOCKET_TIMEOUT=5
REDIS_RECONNECT_INTERVAL=30

# ---- Microsoft Graph API (leave empty in dev; OTP email disabled below) ----
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_MAILBOX_EMAIL=
OTP_FROM_EMAIL=
OTP_FROM_NAME=ATS System (dev)
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_DISABLE_EMAIL=true           # dev only: skip Graph email; OTP/CAPTCHA codes are returned in the API response for local testing
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_WINDOW=5
OTP_SEND_WINDOW_SECONDS=900
GRAPH_SEND_RETRIES=2
GRAPH_SEND_RETRY_DELAY=1.5
# EMAIL_WEBHOOK_SECRET: secret for the email webhook; empty = webhook DISABLED (404)
EMAIL_WEBHOOK_SECRET=

# ---- OpenAI / LLM (required for CV/JD standardization & LLM re-ranking) ----
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini-2025-04-14
OPENAI_MAX_RETRIES=2
OPENAI_RETRY_BASE_DELAY=0.5
OPENAI_SEED=1337
LLM_CACHE_DIR=/data/llm_cache
LLM_TIMEOUT_SECONDS=60
LLM_BULK_TIMEOUT_SECONDS=300

# ---- Storage (local | s3) ----
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=/data/uploads
CV_UPLOAD_DIR=/data/uploads/cv
S3_BUCKET=
S3_REGION=
S3_PREFIX=
MAX_FILE_SIZE_MB=10
MAX_TEXT_INPUT_CHARS=50000
CV_RETENTION_DAYS=0

# ---- Rate limiting (relaxed for dev) ----
RATE_LIMIT_DEBUG=true
ENABLE_RATE_LIMIT_METRICS=true
MAX_GLOBAL_CONCURRENT=50
CIRCUIT_BREAKER_THRESHOLD=10
CIRCUIT_BREAKER_RECOVERY_TIME=300
CLEANUP_INTERVAL=300
MEMORY_CLEANUP_THRESHOLD=10000
REPUTATION_DECAY_RATE=0.05
REPUTATION_PENALTY_RATE=0.02
MIN_REPUTATION=0.5
TRUST_PROXY_HEADERS=true
# Only these peers may set X-Forwarded-For / X-Real-IP (nginx on the Docker network, a cloud load balancer).
# Anyone else's forwarding headers are ignored, so clients cannot pick their own IP to dodge rate limits.
ALLOWED_PROXY_IPS=127.0.0.0/8,::1/128,172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

# ---- Matching performance ----
MAX_CV_LIMIT=300
MATCHING_TIMEOUT_SECONDS=3600
MATCH_CHUNK_SIZE=50
MATCH_CANDIDATE_RETRIES=2        # retries for a CV whose scoring failed (e.g. a Qdrant timeout) before it is left out
MATCH_RETRY_BACKOFF_SECONDS=1.5  # pause before retry n is n x this
MATCH_QDRANT_BATCH_SIZE=256
MATCH_DOC_CACHE_TTL_SECONDS=300
MATCH_DOC_CACHE_MAX_ITEMS=8000
MATCH_RESULT_CACHE_ENABLED=true
MATCH_RESULT_CACHE_TTL_SECONDS=1800
LIST_CACHE_TTL_SECONDS=60
ENABLE_MATCH_QUEUE=true

# ---- Embeddings ----
EMBEDDING_MODEL_NAME=all-mpnet-base-v2
EMBEDDING_DIM=768
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CACHE_TTL_SECONDS=3600

# ---- Queues / workers (smaller for dev) ----
ENABLE_APPLICATION_QUEUE=true
ENABLE_PUBLIC_CV_QUEUE=true
MAX_CONCURRENT_APPLICATIONS=3
APPLICATION_TIMEOUT_SECONDS=300

# ---- System thresholds ----
CPU_THRESHOLD_PERCENT=90

# ---- Feature flags ----
ENABLE_CANDIDATE_TRACKER=true
ENABLE_EMAIL_SCHEDULER=false
SEND_EMAIL_REMINDER_FOLLOWUP=false
EMAIL_CHECK_INTERVAL_MINUTES=5
EMAIL_MAX_BATCH_SIZE=10
EMAIL_SCHEDULE_UTC=
FOLLOWUP_REMINDER_TZ=Asia/Dubai

# ---- Embedding model server (own container; the backend image has no torch) ----
# EMBEDDING_SERVICE_URL is set by docker-compose. MODEL_SERVER_TOKEN is optional shared-secret auth between containers.
MODEL_SERVER_TOKEN=
MODEL_THREADS=2                   # CPU threads the model server uses per batch

# ---- Matching queue (any number of users can match at once; the queue absorbs bursts) ----
MATCH_WORKER_REPLICAS=3           # match-worker processes: one match is CPU-bound in one process, so this is the parallelism
MATCH_WORKER_CONCURRENCY=2        # jobs per process (a 2nd is only taken if no idle process took it)
MATCH_THREAD_POOL_WORKERS=4       # scoring threads per process (2-16 measured the same once reads are batched)
MATCH_QUEUE_MAX_CONCURRENT_JOBS=0 # 0 = no extra global cap across workers
MATCH_QUEUE_MAX_JOBS_PER_USER=0   # 0 = unlimited submissions per user
MATCH_QUEUE_MAX_DEPTH=0           # 0 = unlimited queue length (a positive value rejects with HTTP 429)
LLM_MATCH_TOP_N=50                # best semantic matches re-scored by the LLM
LLM_MATCH_BATCH_SIZE=10           # CVs per LLM request (top-50 = 5 requests, run concurrently)
LLM_MATCH_CONCURRENCY=3           # parallel LLM requests per worker across all matches

# ---- OCR (RapidOCR / ONNX; replaces Tesseract) ----
OCR_MAX_CONCURRENT=2              # recognitions at once per process
OCR_THREADS=2                     # ONNX Runtime threads per recognition
OCR_MAX_PAGES=8                   # scanned pages OCR'd per PDF

# ---- Monitoring (Monitor page: model calls, tokens, cost, queue, workers) ----
MONITORING_ENABLED=true
LLM_DAILY_BUDGET_USD=0            # 0 = no budget alert; otherwise warns at 90% of this daily LLM spend

# ---- Large matches (memory-bounded: any number of CVs can be matched) ----
MATCH_MAX_CVS=0                   # 0 = no ceiling; CVs are scored in chunks, never all in memory
MATCH_DETAIL_TOP_N=1000           # candidates keeping full assignment detail in a result (rest keep scores)
MATCH_RESULT_TTL_SECONDS=3600     # finished results expire sooner than job status
QDRANT_TUNE_COLLECTIONS=true      # turn off the unused HNSW graph + memory-map vectors on startup

# ---- CV ingestion workers (many CVs processed at once) ----
ENABLE_INGEST_QUEUE=true         # uploads are queued while a background worker is online
INGEST_WORKER_CONCURRENCY=4      # CVs processed at once per background worker
INGEST_LLM_CONCURRENCY=4         # of those, how many may be in the LLM call at once (OpenAI rate-limit guard)
INGEST_EMBED_CONCURRENCY=2       # ... and in the embedding model server
