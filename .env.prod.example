# AlphaCV PROD settings: raw files in S3, PostgreSQL on AWS RDS. Template: commit THIS file, never .env.prod.
# `scripts/start.sh prod` creates .env.prod from this file on first run and refuses to start while CHANGE_ME remains.
# Only what you must or may change is listed: every other setting has its default in backend/app/config/settings.py
# (sizes and process counts are in docker-compose.prod.yml).

# ---- Environment ----
ENVIRONMENT=production
NODE_ENV=production

# ---- URLs / CORS ----
DOMAIN=your-domain.example                        # nginx server_name + TLS certificate path
FRONTEND_URL=https://your-domain.example
FRONTEND_ORIGIN=https://your-domain.example       # comma-separated CORS allowlist
NEXT_PUBLIC_API_URL=https://your-domain.example   # frontend -> backend base (through nginx /api)

# ---- Secrets and the admin account ----
# SECRET_KEY signs the login tokens (at least 32 characters): python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME
# The admin's email and password are applied from here at every start; they cannot be changed in the app.
ADMIN_USERNAME=CHANGE_ME          # only the name shown in the app
ADMIN_EMAIL=admin@gmail.com       # what the admin signs in with
ADMIN_PASSWORD=CHANGE_ME
# Shared secret between the backend and the model server (compose passes it to both): set a random value.
MODEL_SERVER_TOKEN=CHANGE_ME
# Optional. Encrypts the authenticator-app secrets (Microsoft Authenticator sign-in). Empty = derived from SECRET_KEY, and then changing
# SECRET_KEY means each authenticator is reset again. Set a random value to keep them: python -c "import secrets;print(secrets.token_urlsafe(48))"
TOTP_ENCRYPTION_KEY=

# ---- PostgreSQL: ONE database for users, candidates, jobs, AI agents and bug reports ----
# Production runs no Postgres container: this is your AWS RDS endpoint. Run scripts/db/init/rds-bootstrap.sql against it ONCE first
# to create the application role; the schema is created by the backend at start-up (alembic). sslmode=require keeps TLS to RDS.
# cv_user's password is the one you set when running rds-bootstrap.sql. If it has special characters (@ : / # ? %), URL-encode them.
DATABASE_URL=postgresql+psycopg2://cv_user:CHANGE_ME@alpha-cv-prod.xxxxxxxxxxxx.eu-north-1.rds.amazonaws.com:5432/alpha_cv_prod_db?sslmode=require

# ---- Storage: raw CV / JD files in S3 ----
# Credentials come from the IAM role attached to the EC2 instance (a policy scoped to this one bucket): no AWS keys in this file.
# Docker needs the instance metadata hop limit set to 2 for the containers to reach the role. Keep the bucket private,
# versioned and encrypted. Without a role, add AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY of a bucket-scoped IAM user here.
STORAGE_BACKEND=s3
S3_BUCKET=your-cv-storage-bucket
S3_REGION=eu-north-1
S3_PREFIX=                        # optional key prefix inside the bucket

# ---- Qdrant (vector store) and Redis (cache, rate limits, OTP, queues): containers on this host ----
QDRANT_HOST=qdrant
# Optional: when set, Qdrant requires it (the backend reads the same value). Keep the value on the line, with no comment after it.
QDRANT_API_KEY=
REDIS_HOST=redis
# Optional: when set, Redis requires it (the backend reads the same value). Keep the value on the line, with no comment after it.
REDIS_PASSWORD=

# ---- Email (Microsoft Graph): sign-in codes ----
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_MAILBOX_EMAIL=
OTP_FROM_EMAIL=cv@your-domain.example

# ---- LLM (OpenRouter): needed to read CVs / job descriptions and to re-rank matches ----
OPENROUTER_API_KEY=CHANGE_ME      # https://openrouter.ai/keys
LLM_MODEL=anthropic/claude-haiku-5.5    # OpenRouter model id, used for extraction, matching and the AI agents
EMBEDDING_TEXT_PREFIX="query: "   # e5 task prefix; set it empty for a non-e5 model

# ---- Reverse proxy ----
TRUST_PROXY_HEADERS=true
# Only these peers may set X-Forwarded-For / X-Real-IP (nginx on the Docker network, a cloud load balancer); anyone else's
# forwarding headers are ignored, so clients cannot pick their own IP to dodge the rate limits.
ALLOWED_PROXY_IPS=127.0.0.0/8,::1/128,172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

# ---- Features ----
ENABLE_PUBLIC_CV_QUEUE=true       # public applications -> Redis queue -> background worker

# ---- Uploaded files: optional antivirus (ClamAV daemon, e.g. tcp://clamav:3310). Empty = off.
# Every upload is already checked by content, size, bombs, macros and scripts (app/security/uploads.py).
CLAMAV_URL=
CLAMAV_REQUIRED=false            # true = reject uploads when the scanner cannot be reached
