# AlphaCV PROD settings (S3 + AWS RDS). Template: commit THIS file, never .env.prod.
# `scripts/start.sh prod` creates .env.prod from it on first run and refuses to start while CHANGE_ME remains.
# ============================================================================
# ATS Platform — single source of truth for ALL configuration (PRODUCTION).
# Copy to .env and fill in. Nothing is hardcoded in code; every value is read
# from here (or the process environment) at runtime.
# Use .env.development.example for the dev stack (.env.dev).
# ============================================================================

# ---- Environment ----
ENVIRONMENT=production            # development | production
NODE_ENV=production
HOST=0.0.0.0
PORT=8000
UVICORN_WORKERS=2                 # 4 vCPU host: 2 API workers, leave cores for match-worker

# ---- Compute ----
TORCH_NUM_THREADS=1               # CPU-only; bound BLAS/torch so containers don't oversubscribe vCPUs

# ---- URLs / CORS ----
DOMAIN=your-domain.example                        # nginx server_name + TLS cert path
FRONTEND_URL=https://your-domain.example
FRONTEND_ORIGIN=https://your-domain.example       # comma-separated CORS allowlist
NEXT_PUBLIC_API_URL=https://your-domain.example   # frontend -> backend base (via nginx /api)

# ---- Security / Auth (generate: python -c "import secrets;print(secrets.token_urlsafe(48))") ----
SECRET_KEY=CHANGE_ME
JWT_SECRET_KEY=CHANGE_ME
ACCESS_TOKEN_EXPIRES_MIN=720
ADMIN_USERNAME=CHANGE_ME
ADMIN_PASSWORD=CHANGE_ME
LOCAL_AUTH=false
LOCAL_AUTH_USERNAME=             # dev-only login bypass; leave empty in production
LOCAL_AUTH_PASSWORD=             # dev-only login bypass; leave empty in production
LOGIN_MAX_FAILED_ATTEMPTS=5      # wrong passwords before temporary lockout
LOGIN_LOCKOUT_SECONDS=900        # lockout duration (15 min)
LOGIN_MAX_FAILED_ATTEMPTS_PER_ACCOUNT=50   # failures from ALL addresses before the account itself locks
# (LOGIN_MAX_FAILED_ATTEMPTS counts per username AND client IP, so a stranger cannot lock a real user out)
PRESENCE_TTL_SECONDS=120         # user shows "online" on the admin page if seen within this many seconds

# ---- PostgreSQL: ONE database for users, the tracker and email intake ----
# Production runs NO local Postgres container: point DATABASE_URL at your AWS RDS
# (PostgreSQL) endpoint. Run db/init/rds-bootstrap.sql against it ONCE first to
# create the application role. The schema itself is created by the backend at
# startup (`alembic upgrade head`, history in backend/migrations).
# sslmode=require enforces TLS to RDS; keep it.
DATABASE_URL=postgresql+psycopg2://cv_user:CHANGE_ME@your-db-instance.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com:5432/cv_database?sslmode=require

# ---- Qdrant (vector store) ----
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_MAX_CONNECTIONS=400
QDRANT_TIMEOUT_SECONDS=30
# QDRANT_API_KEY: optional; set to require auth to Qdrant (backend + qdrant service read it)
QDRANT_API_KEY=

# ---- Redis (cache, rate-limit state, OTP, queue broker) ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=50          # connection-pool size per process
REDIS_SOCKET_TIMEOUT=5            # seconds
REDIS_RECONNECT_INTERVAL=30       # retry Redis this often after an outage
REDIS_MAXMEMORY=2gb               # redis-server maxmemory (compose); keep <= redis container mem limit
REDIS_MAXCLIENTS=800

# ---- Microsoft Graph API (OTP email + mailbox CV intake) ----
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_MAILBOX_EMAIL=
OTP_FROM_EMAIL=cv@your-domain.example
OTP_FROM_NAME=ATS System
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_DISABLE_EMAIL=false  # dev only
OTP_RESEND_COOLDOWN_SECONDS=60   # min seconds between OTP emails per user
OTP_MAX_SENDS_PER_WINDOW=5       # OTP emails allowed per rolling window
OTP_SEND_WINDOW_SECONDS=900      # rolling window for the above (15 min)

# Image CAPTCHA (alternative second factor; set a user's auth mode to "captcha" in Admin)
CAPTCHA_LENGTH=6                 # characters in the CAPTCHA code
CAPTCHA_TTL_SECONDS=300          # how long a CAPTCHA challenge stays valid
CAPTCHA_MAX_ATTEMPTS=5           # wrong answers before the challenge is invalidated
CAPTCHA_MAX_SENDS_PER_WINDOW=8   # refreshes allowed per rolling window (sliding window)
CAPTCHA_SEND_WINDOW_SECONDS=600  # rolling window for the above (10 min)
CAPTCHA_RESEND_COOLDOWN_SECONDS=2 # min seconds between refreshes
GRAPH_SEND_RETRIES=2             # retries for transient Graph sendMail failures
GRAPH_SEND_RETRY_DELAY=1.5       # base backoff delay (seconds)

# ---- LLM (OpenRouter) / LLM ----
OPENROUTER_API_KEY=CHANGE_ME      # https://openrouter.ai/keys
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=anthropic/claude-haiku-5.5    # OpenRouter model id; used for extraction, matching and the AI agents
LLM_MAX_RETRIES=2
OPENROUTER_ZDR=false                # true = only providers that keep no prompts (zero data retention)
LLM_RETRY_BASE_DELAY=0.5
LLM_TIMEOUT_SECONDS=60
LLM_BULK_TIMEOUT_SECONDS=300

# ---- Storage (local | s3) ----
# Production stores CV/JD files in S3, not on the box. Credentials come from
# the EC2 instance's IAM role (attach a policy scoped to this one bucket) —
# do NOT put AWS access keys in this file. Enable versioning + default
# encryption (SSE-S3 or a KMS key) on the bucket itself.
STORAGE_BACKEND=s3                # local (uploads_data volume, dev only) | s3 (AWS S3)
LOCAL_STORAGE_DIR=/data/uploads
CV_UPLOAD_DIR=/data/uploads/cv
S3_BUCKET=your-cv-storage-bucket  # required when STORAGE_BACKEND=s3
S3_REGION=us-east-1
S3_PREFIX=                        # optional key prefix inside the bucket
MAX_FILE_SIZE_MB=10
MAX_TEXT_INPUT_CHARS=50000
# Raw-CV retention: db/cleanup_old_cvs.py purges original files + embeddings
# of CVs older than this many days (0 = keep forever). Structured/search data,
# notes, tracker, auth and email-dedup records are always kept.
CV_RETENTION_DAYS=0

# ---- Rate limiting ----
RATE_LIMIT_DEBUG=false
ENABLE_RATE_LIMIT_METRICS=true
MAX_GLOBAL_CONCURRENT=100
CIRCUIT_BREAKER_THRESHOLD=10
CIRCUIT_BREAKER_RECOVERY_TIME=120
CLEANUP_INTERVAL=300
MEMORY_CLEANUP_THRESHOLD=10000
REPUTATION_DECAY_RATE=0.05
REPUTATION_PENALTY_RATE=0.02
MIN_REPUTATION=0.5
TRUST_PROXY_HEADERS=true
# Only these peers may set X-Forwarded-For / X-Real-IP (nginx on the Docker network, a cloud load balancer).
# Anyone else's forwarding headers are ignored, so clients cannot pick their own IP to dodge rate limits.
ALLOWED_PROXY_IPS=127.0.0.0/8,::1/128,172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

# ---- Matching performance ----
# Matching now runs in the dedicated match-worker container via a Redis queue.
# There is no longer a small hard cap on CVs per job — the worker streams
# candidates in chunks. MATCH_MAX_CVS (10,000) is the most CVs one match may score.
MATCHING_TIMEOUT_SECONDS=3600    # hard timeout for one matching job
MATCH_CHUNK_SIZE=50              # CVs processed per parallel chunk
MATCH_CANDIDATE_RETRIES=2        # retries for a CV whose scoring failed (e.g. a Qdrant timeout) before it is left out
MATCH_RETRY_BACKOFF_SECONDS=1.5  # pause before retry n is n x this
MATCH_QDRANT_BATCH_SIZE=256      # CV payloads fetched per Qdrant round-trip
MATCH_DOC_CACHE_TTL_SECONDS=300  # in-process TTL cache for Qdrant docs/embeddings
MATCH_DOC_CACHE_MAX_ITEMS=8000
MATCH_RESULT_CACHE_ENABLED=true  # Redis cache for (cv, jd, weights) match results
MATCH_RESULT_CACHE_TTL_SECONDS=1800
LIST_CACHE_TTL_SECONDS=60        # CV/JD list endpoint cache TTL

# ---- Match job queue (Redis-backed; consumed by the match-worker container) ----
ENABLE_MATCH_QUEUE=true          # false = run matching inline in the API process (not recommended)
MATCH_QUEUE_POLL_TIMEOUT=5       # worker blocking-pop timeout (seconds)
MATCH_JOB_STALE_SECONDS=5400     # a 'processing' job older than this is re-queued on worker startup
MATCH_JOB_TTL_SECONDS=86400      # how long job status + results live in Redis

# ---- Embeddings ----
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
EMBEDDING_DIM=384                 # multilingual-e5-small vector size (change model => recreate collections, re-upload CVs / JDs)
EMBEDDING_TEXT_PREFIX="query: "   # e5 task prefix; set it empty for a non-e5 model
EMBEDDING_BATCH_SIZE=64
EMBEDDING_CACHE_TTL_SECONDS=3600

# ---- Queues / workers ----
ENABLE_APPLICATION_QUEUE=true
ENABLE_PUBLIC_CV_QUEUE=true       # public applications -> Redis queue -> public-cv-worker container
MAX_CONCURRENT_APPLICATIONS=5
APPLICATION_TIMEOUT_SECONDS=300

# ---- System thresholds ----
CPU_THRESHOLD_PERCENT=85

# ---- Feature flags ----
ENABLE_CANDIDATE_TRACKER=true
SEND_EMAIL_REMINDER_FOLLOWUP=false
FOLLOWUP_REMINDER_TZ=Asia/Dubai

# ---- Embedding model server (own container; the backend image has no ML runtime) ----
# EMBEDDING_SERVICE_URL is set by docker-compose. MODEL_SERVER_TOKEN is optional shared-secret auth between containers.
MODEL_SERVER_TOKEN=
MODEL_THREADS=2                   # CPU threads the model server uses per batch

# ---- Matching queue (any number of users can match at once; the queue absorbs bursts) ----
MATCH_WORKER_REPLICAS=3           # match-worker processes: one match is CPU-bound in one process, so this is the parallelism
MATCH_WORKER_CONCURRENCY=2        # jobs per process (a 2nd is only taken if no idle process took it)
MATCH_THREAD_POOL_WORKERS=4       # scoring threads per process (2-16 measured the same once reads are batched)
MATCH_QUEUE_MAX_CONCURRENT_JOBS=0 # 0 = no extra global cap across workers
MATCH_QUEUE_MAX_JOBS_PER_USER=0   # 0 = unlimited submissions per user
MATCH_QUEUE_MAX_DEPTH=0           # 0 = unlimited queue length (a positive value rejects with HTTP 429)
LLM_MATCH_TOP_N=30                # best semantic matches re-scored by the LLM
LLM_MATCH_BATCH_SIZE=10           # CVs per LLM request (top-30 = 3 requests, run concurrently)
LLM_MATCH_CONCURRENCY=3           # parallel LLM requests per worker across all matches

# ---- OCR (RapidOCR / ONNX; replaces Tesseract) ----
OCR_MAX_CONCURRENT=2              # recognitions at once per process
OCR_THREADS=2                     # ONNX Runtime threads per recognition
OCR_MAX_PAGES=8                   # scanned pages OCR'd per PDF

# ---- Monitoring (Monitor page: model calls, tokens, cost, queue, workers) ----
MONITORING_ENABLED=true
LLM_DAILY_BUDGET_USD=0            # 0 = no budget alert; otherwise warns at 90% of this daily LLM spend

# ---- Large matches (memory-bounded: any number of CVs can be matched) ----
MATCH_MAX_CVS=10000              # the most CVs one match may score
MATCH_DETAIL_TOP_N=1000           # candidates keeping full assignment detail in a result (rest keep scores)
MATCH_RESULT_TTL_SECONDS=3600     # finished results expire sooner than job status
QDRANT_TUNE_COLLECTIONS=true      # turn off the unused HNSW graph + memory-map vectors on startup

# ---- CV ingestion workers (many CVs processed at once) ----
ENABLE_INGEST_QUEUE=true         # uploads are queued while a background worker is online
INGEST_WORKER_CONCURRENCY=4      # CVs processed at once per background worker
INGEST_LLM_CONCURRENCY=4         # of those, how many may be in the LLM call at once (OpenAI rate-limit guard)
INGEST_EMBED_CONCURRENCY=2       # ... and in the embedding model server

# ---- Uploaded files: optional antivirus (ClamAV daemon, e.g. tcp://clamav:3310). Empty = off.
# Every upload is already checked by content, size, bombs, macros and scripts (app/security/uploads.py).
CLAMAV_URL=
CLAMAV_REQUIRED=false            # true = reject uploads when the scanner cannot be reached

# ---- Agentic mode (one assistant that uses the app's features; see backend/app/agentic). Every model role defaults to LLM_MODEL.
AGENTIC_ENABLED=true
AGENTIC_MODEL_ROUTER=
AGENTIC_MODEL_ACT=
AGENTIC_MODEL_WRITE=
AGENTIC_MODEL_FALLBACK=
AGENTIC_MAX_STEPS=5
AGENTIC_MATCH_WAIT_SECONDS=40
