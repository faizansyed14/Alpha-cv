# AlphaCV LOCAL settings (Postgres + raw files in Docker volumes, no S3 / RDS). Template: commit THIS file.
# `scripts/start.sh local` creates .env.local from it on first run; fill in OPENROUTER_API_KEY and the other CHANGE_ME values.
# (docker-compose.local.yml forces the local database and storage whatever is written here.)
# ============================================================================
# ATS Platform — DEVELOPMENT configuration. Copy to .env.dev.
# Used by docker-compose.dev.yml (./scripts/start.sh dev).
# Service hostnames refer to the dev compose network (postgres-dev, qdrant-dev,
# redis-dev). Dev-only conveniences (LOCAL_AUTH, OTP_DISABLE_EMAIL) are enabled
# here and are hard-disabled by the backend when ENVIRONMENT=production.
# ============================================================================

# ---- Environment ----
ENVIRONMENT=development
NODE_ENV=development
HOST=0.0.0.0
PORT=8000
UVICORN_WORKERS=2

# ---- Compute ----
TORCH_NUM_THREADS=1

# ---- URLs / CORS ----
DOMAIN=CHANGE_ME
FRONTEND_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000,http://localhost
NEXT_PUBLIC_API_URL=http://localhost

# ---- Security / Auth ----
SECRET_KEY=CHANGE_ME
JWT_SECRET_KEY=CHANGE_ME
ACCESS_TOKEN_EXPIRES_MIN=1440
ADMIN_USERNAME=CHANGE_ME
ADMIN_PASSWORD=CHANGE_ME
LOCAL_AUTH=true                  # dev-only login bypass (ignored in production)
LOCAL_AUTH_USERNAME=CHANGE_ME
LOCAL_AUTH_PASSWORD=CHANGE_ME
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
PRESENCE_TTL_SECONDS=120         # user shows "online" on the admin page if seen within this many seconds

# ---- PostgreSQL (dev container: postgres-dev, host port 5434) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cv_analyzer_dev
DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres-local:5432/cv_analyzer_dev

# ---- Qdrant (dev container: qdrant-dev, host port 6335) ----
QDRANT_HOST=qdrant-dev
QDRANT_PORT=6333
QDRANT_MAX_CONNECTIONS=10
QDRANT_TIMEOUT_SECONDS=30
# QDRANT_API_KEY: optional; set to require auth to Qdrant (backend + qdrant service read it)
QDRANT_API_KEY=

# ---- Redis (dev container: redis-dev, host port 6380) ----
REDIS_HOST=redis-dev
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=20
REDIS_SOCKET_TIMEOUT=5
REDIS_RECONNECT_INTERVAL=30

# ---- Microsoft Graph API (leave empty in dev; OTP email disabled below) ----
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_MAILBOX_EMAIL=
OTP_FROM_EMAIL=
OTP_FROM_NAME=ATS System (dev)
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_FIXED_CODE=123456            # dev only: fixed OTP when email sending disabled
OTP_DISABLE_EMAIL=true           # dev only: skip Graph email, use OTP_FIXED_CODE
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_WINDOW=5
OTP_SEND_WINDOW_SECONDS=900
GRAPH_SEND_RETRIES=2
GRAPH_SEND_RETRY_DELAY=1.5

# ---- LLM (OpenRouter) / LLM (required for CV/JD standardization & LLM re-ranking) ----
OPENROUTER_API_KEY=CHANGE_ME      # https://openrouter.ai/keys
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=anthropic/claude-haiku-5.5    # OpenRouter model id; used for extraction, matching and the AI agents
LLM_MAX_RETRIES=2
OPENROUTER_ZDR=false                # true = only providers that keep no prompts (zero data retention)
LLM_RETRY_BASE_DELAY=0.5
LLM_TIMEOUT_SECONDS=60
LLM_BULK_TIMEOUT_SECONDS=300

# ---- Storage (local | s3) ----
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=/data/uploads
CV_UPLOAD_DIR=/data/uploads/cv
S3_BUCKET=
S3_REGION=
S3_PREFIX=
MAX_FILE_SIZE_MB=10
MAX_TEXT_INPUT_CHARS=50000
CV_RETENTION_DAYS=0

# ---- Rate limiting (relaxed for dev) ----
RATE_LIMIT_DEBUG=true
ENABLE_RATE_LIMIT_METRICS=true
MAX_GLOBAL_CONCURRENT=50
CIRCUIT_BREAKER_THRESHOLD=10
CIRCUIT_BREAKER_RECOVERY_TIME=300
CLEANUP_INTERVAL=300
MEMORY_CLEANUP_THRESHOLD=10000
REPUTATION_DECAY_RATE=0.05
REPUTATION_PENALTY_RATE=0.02
MIN_REPUTATION=0.5
TRUST_PROXY_HEADERS=true
ALLOWED_PROXY_IPS=172.16.0.0/12,10.0.0.0/8

# ---- Matching performance ----
MATCH_MAX_CVS=10000
MATCHING_TIMEOUT_SECONDS=3600
MAX_CONCURRENT_MATCHES=2
MATCH_THREAD_POOL_WORKERS=4
MATCH_CHUNK_SIZE=50
MATCH_QDRANT_BATCH_SIZE=256
MATCH_DOC_CACHE_TTL_SECONDS=300
MATCH_DOC_CACHE_MAX_ITEMS=8000
MATCH_RESULT_CACHE_ENABLED=true
MATCH_RESULT_CACHE_TTL_SECONDS=1800
LIST_CACHE_TTL_SECONDS=60

# ---- Match job queue (Redis-backed; consumed by the match-worker-dev container) ----
ENABLE_MATCH_QUEUE=true
MATCH_QUEUE_MAX_CONCURRENT_JOBS=1
MATCH_QUEUE_POLL_TIMEOUT=5
MATCH_JOB_STALE_SECONDS=5400
MATCH_JOB_TTL_SECONDS=86400

# ---- Embeddings ----
# multilingual-e5-small (384-d), run by the model-server container. Changing the model or the dimension means recreating
# the Qdrant collections (the stored vectors are not comparable between models) and re-uploading the CVs / JDs.
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
EMBEDDING_DIM=384
EMBEDDING_TEXT_PREFIX="query: "   # e5 task prefix; set it empty for a non-e5 model
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CACHE_TTL_SECONDS=3600

# ---- Queues / workers (smaller for dev) ----
ENABLE_APPLICATION_QUEUE=true
ENABLE_PUBLIC_CV_QUEUE=true
MAX_CONCURRENT_APPLICATIONS=3
APPLICATION_TIMEOUT_SECONDS=300
MIN_QUEUE_WORKERS=2
MAX_QUEUE_WORKERS=8
QUEUE_SIZE_THRESHOLD=1000

# ---- System thresholds ----
MEMORY_THRESHOLD_MB=4096
CPU_THRESHOLD_PERCENT=90

# ---- Feature flags ----
ENABLE_CANDIDATE_TRACKER=true
SEND_EMAIL_REMINDER_FOLLOWUP=false
FOLLOWUP_REMINDER_TZ=Asia/Dubai

# ---- Uploaded files: optional antivirus (ClamAV daemon, e.g. tcp://clamav:3310). Empty = off.
# Every upload is already checked by content, size, bombs, macros and scripts (app/security/uploads.py).
CLAMAV_URL=
CLAMAV_REQUIRED=false            # true = reject uploads when the scanner cannot be reached

# ---- Agentic mode (one assistant that uses the app's features; see backend/app/agentic). Every model role defaults to LLM_MODEL.
AGENTIC_ENABLED=true
AGENTIC_MODEL_ROUTER=
AGENTIC_MODEL_ACT=
AGENTIC_MODEL_WRITE=
AGENTIC_MODEL_FALLBACK=
AGENTIC_MAX_STEPS=5
AGENTIC_MATCH_WAIT_SECONDS=40
