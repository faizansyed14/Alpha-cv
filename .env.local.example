# AlphaCV LOCAL settings: everything on this machine (Postgres and raw files in Docker volumes, no S3 / RDS).
# `scripts/start.sh local` creates .env.local from this file on first run; fill in the CHANGE_ME values.
# docker-compose.local.yml pins the database, file storage and the Qdrant / Redis addresses, whatever is written here.
# Only what you must or may change is listed: every other setting has its default in backend/app/config/settings.py.

# ---- Environment ----
ENVIRONMENT=development
NODE_ENV=development

# ---- URLs / CORS ----
FRONTEND_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000,http://localhost
NEXT_PUBLIC_API_URL=http://localhost

# ---- Secrets and the admin account ----
# SECRET_KEY signs the login tokens: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME
# The admin's email and password are applied from here at every start; they cannot be changed in the app.
ADMIN_USERNAME=CHANGE_ME          # only the name shown in the app
ADMIN_EMAIL=admin@gmail.com       # what the admin signs in with
ADMIN_PASSWORD=CHANGE_ME
# Dev-only password-only login that skips the second factor (ignored in production). Off unless you add these three lines:
# LOCAL_AUTH=true
# LOCAL_AUTH_USERNAME=
# LOCAL_AUTH_PASSWORD=

# ---- PostgreSQL (container postgres-local, host port 5434) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cv_analyzer_dev
# Memory (the defaults are small; raise them as the data grows, e.g. ~100k CVs on 4 GB):
#   POSTGRES_MEMORY_LIMIT=4G  POSTGRES_SHARED_BUFFERS=1GB  POSTGRES_EFFECTIVE_CACHE_SIZE=3GB  POSTGRES_WORK_MEM=16MB

# ---- Email (Microsoft Graph) ----
# Leave empty here: OTP_DISABLE_EMAIL=true skips the email and the sign-in page gets the code from the API instead. Never true in production.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_MAILBOX_EMAIL=
OTP_FROM_EMAIL=
OTP_DISABLE_EMAIL=true

# ---- LLM (OpenRouter): needed to read CVs / job descriptions and to re-rank matches ----
OPENROUTER_API_KEY=CHANGE_ME      # https://openrouter.ai/keys
LLM_MODEL=anthropic/claude-haiku-5.5    # OpenRouter model id, used for extraction, matching and the AI agents

# ---- Embedding model server ----
# Shared secret between the backend and the model server (compose passes it to both). Empty = off (internal network only).
MODEL_SERVER_TOKEN=
EMBEDDING_TEXT_PREFIX="query: "   # e5 task prefix; set it empty for a non-e5 model

# ---- Reverse proxy (who may set X-Forwarded-For: the Docker network) ----
TRUST_PROXY_HEADERS=true
ALLOWED_PROXY_IPS=172.16.0.0/12,10.0.0.0/8

# ---- Features ----
ENABLE_CANDIDATE_TRACKER=true
ENABLE_PUBLIC_CV_QUEUE=true       # public applications -> Redis queue -> background worker

# ---- Uploaded files: optional antivirus (ClamAV daemon, e.g. tcp://clamav:3310). Empty = off.
# Every upload is already checked by content, size, bombs, macros and scripts (app/security/uploads.py).
CLAMAV_URL=
CLAMAV_REQUIRED=false            # true = reject uploads when the scanner cannot be reached
